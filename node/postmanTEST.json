{
  "info": {
    "name": "ChatsApp MERN Backend API",
    "_postman_id": "c5d8f090-9df3-11ef-8c67-4b46f9c93f00",
    "description": "Postman collection for ChatsApp backend built with Node.js, Express, MongoDB, and Socket.io",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "AUTH",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"123456\",\n  \"profilePic\": \"https://i.ibb.co/7CQVJNm/placeholder.jpg\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/auth/register" }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/auth/login" }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "http://localhost:5000/api/auth/me" }
          }
        },
        {
          "name": "Logout User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "http://localhost:5000/api/auth/logout" }
          }
        }
      ]
    },
    {
      "name": "USERS",
      "item": [
        {
          "name": "Get All Users (Search)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "http://localhost:5000/api/users?search=john"
            }
          }
        },
        {
          "name": "Get User By ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "http://localhost:5000/api/users/{{userId}}"
            }
          }
        },
        {
          "name": "Update User Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Name\",\n  \"profilePic\": \"https://i.ibb.co/updated.jpg\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/users/{{userId}}"
            }
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "http://localhost:5000/api/users/{{userId}}"
            }
          }
        }
      ]
    },
    {
      "name": "CHATS",
      "item": [
        {
          "name": "Access or Create One-on-One Chat",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{receiverId}}\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/chats" }
          }
        },
        {
          "name": "Get All Chats",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "http://localhost:5000/api/chats" }
          }
        },
        {
          "name": "Create Group Chat",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Study Group\",\n  \"users\": [\"{{user1}}\", \"{{user2}}\", \"{{user3}}\"]\n}"
            },
            "url": { "raw": "http://localhost:5000/api/chats/group" }
          }
        },
        {
          "name": "Rename Group",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chatId\": \"{{chatId}}\",\n  \"chatName\": \"New Group Name\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/chats/rename" }
          }
        },
        {
          "name": "Add User to Group",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chatId\": \"{{chatId}}\",\n  \"userId\": \"{{userId}}\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/chats/groupadd" }
          }
        },
        {
          "name": "Remove User from Group",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chatId\": \"{{chatId}}\",\n  \"userId\": \"{{userId}}\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/chats/groupremove" }
          }
        }
      ]
    },
    {
      "name": "MESSAGES",
      "item": [
        {
          "name": "Send Message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Hello there!\",\n  \"chatId\": \"{{chatId}}\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/messages" }
          }
        },
        {
          "name": "Get Messages by Chat ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "http://localhost:5000/api/messages/{{chatId}}"
            }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "token", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "chatId", "value": "" },
    { "key": "receiverId", "value": "" }
  ]
}
